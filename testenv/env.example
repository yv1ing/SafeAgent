# Copy to testenv/.env. The key is sent only by channel requests leaving the lab.
SAFEAGENT_UPSTREAM_KEY=sk-replace-with-a-provider-key
SAFEAGENT_UPSTREAM_MODEL=replace-with-a-model-name
# One endpoint per wire format. All three must reach the same provider account.
SAFEAGENT_UPSTREAM_CHAT_URL=https://provider.example/v1/chat/completions
SAFEAGENT_UPSTREAM_RESPONSES_URL=https://provider.example/v1/responses
SAFEAGENT_UPSTREAM_MESSAGES_URL=https://provider.example/v1/messages
# Leave empty to generate a fresh password and write it to runtime/env.
SAFEAGENT_ADMIN_PASSWORD=
