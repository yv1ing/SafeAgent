# Copy to testenv/.env. Every value is read by the lab scripts only.
# A format is enabled when its base URL, key and model are present. The shared
# key, model and provider below are fallbacks; a format-specific value wins.
# A URL is the provider base URL, without the endpoint path the catalog adds. The
# channel carries that URL as its base URL; the seeded provider rows are not
# rewritten. Extra headers and limits are never shared.

SAFEAGENT_UPSTREAM_KEY=
SAFEAGENT_UPSTREAM_MODEL=
SAFEAGENT_UPSTREAM_PROVIDER=

# Chat Completions
SAFEAGENT_UPSTREAM_CHAT_URL=
SAFEAGENT_UPSTREAM_CHAT_KEY=
SAFEAGENT_UPSTREAM_CHAT_MODEL=
SAFEAGENT_UPSTREAM_CHAT_PROVIDER=openai

# Responses
SAFEAGENT_UPSTREAM_RESPONSES_URL=
SAFEAGENT_UPSTREAM_RESPONSES_KEY=
SAFEAGENT_UPSTREAM_RESPONSES_MODEL=
SAFEAGENT_UPSTREAM_RESPONSES_PROVIDER=openai

# Anthropic Messages
SAFEAGENT_UPSTREAM_MESSAGES_URL=
SAFEAGENT_UPSTREAM_MESSAGES_KEY=
SAFEAGENT_UPSTREAM_MESSAGES_MODEL=
SAFEAGENT_UPSTREAM_MESSAGES_PROVIDER=anthropic

# Gemini (optional)
SAFEAGENT_UPSTREAM_GEMINI_URL=
SAFEAGENT_UPSTREAM_GEMINI_KEY=
SAFEAGENT_UPSTREAM_GEMINI_MODEL=
SAFEAGENT_UPSTREAM_GEMINI_PROVIDER=google

# Optional per-format settings.
# SAFEAGENT_UPSTREAM_<FORMAT>_HEADERS_JSON={"api-key":"..."}
# Required for make lab-load and make lab-acceptance, one per configured format.
# SAFEAGENT_UPSTREAM_<FORMAT>_ENDPOINT=   # full direct URL for the performance baseline
# SAFEAGENT_UPSTREAM_<FORMAT>_DEFAULT_MAX_OUTPUT_TOKENS=
# SAFEAGENT_UPSTREAM_<FORMAT>_NO_THINKING=1  # set 0 when the provider rejects the disable field

# Optional protocol case toggles, all default to 1; 0 removes the case from the matrix.
# SAFEAGENT_TEST_REASONING=
# SAFEAGENT_TEST_MEDIA=
# SAFEAGENT_TEST_STRUCTURED=
# SAFEAGENT_TEST_SERVER_TOOLS=

# Optional console browser settings, used by make lab-browser.
# SAFEAGENT_ADMIN_NEW_PASSWORD=  # new password when the forced change is pending
# SAFEAGENT_SCREENSHOTS=         # screenshot directory inside the browser container

# Leave empty to generate a fresh password and write it to runtime/env.
SAFEAGENT_ADMIN_PASSWORD=
